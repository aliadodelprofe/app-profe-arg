# Copiá este archivo como .env.local y completá los valores reales.
# .env.local NUNCA se sube a GitHub.

# Supabase — proyecto de desarrollo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IMPORTANTE: la service_role key de Supabase NO va acá ni en ningún
# archivo del front-end. Solo en el servidor, si alguna vez hace falta.

# Solo para correr las pruebas de la base desde la Terminal (npm run prueba:base).
# Supabase → Project Settings → Database → Connection string → URI, cambiando
# [YOUR-PASSWORD] por la contraseña real. No la usa la app: solo el script.
DATABASE_URL=
